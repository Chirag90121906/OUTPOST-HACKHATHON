# Vercel Postgres (recommended for deployment)
# When you add Vercel Postgres storage, Vercel injects POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# App
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
APP_URL="http://localhost:3000"

# Optional: for LLM-powered assistant (never expose in client)
# OPENAI_API_KEY=
# AI_PROVIDER=openai
